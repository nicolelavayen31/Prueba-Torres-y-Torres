{
  "Authentication": {
    "Jwt": {
      "Issuer": "AuthService",
      "Audience": "AuthService.Client",
      "LifetimeMinutes": 20,
      "RefreshLifetimeDays": 14
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}